# Secrets for this agent. Never commit real values.
#
# The gateway reads this file at /opt/data/.env through the home mount. It is
# the ONLY place credentials belong -- compose passes none.

# Written in place by `agent-mgr activate`. Do not fill these by hand: the chat
# uid and token are minted together by the activation exchange, and a hand-typed
# pair that does not match will authenticate as nothing.
PLOW_CHAT_CHAT_UID=
PLOW_CHAT_TOKEN=

# Plow Latch: which Mac this agent drives, and its relay credential. Mint both
# from the Mac running Latch -- POST /v1/relay/agents needs the relay:device
# scope, which only that Mac holds.
#
# If this agent drives no Mac, delete the `latch:` block from its config.yaml
# rather than leaving these blank: the config is what declares latch, so a
# declared latch with no credential is a broken agent, not an unconfigured one.
DOMO_DEVICE_UID=
DOMO_MCP_TOKEN=
