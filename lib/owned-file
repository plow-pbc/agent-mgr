#!/usr/bin/env python3
"""Read or replace a file inside an agent's home, without following a link out.

The home is bind-mounted at /opt/data with the gateway running as the
operator's uid (templates/compose.yml), so every leaf in it is
container-writable. A host-side tool that opens one by path is doing
check-then-use no matter how carefully it checks first: resolving the path
proves what it pointed at a moment ago, not what it points at when the read
happens. Issue #25 names the containment-complete form -- hold the home as a
directory FD and do the work relative to it with no-follow semantics -- and
that is what this is.

Two operations, because that is what replacing a file in the home takes:

    lib/owned-file read  <home> <leaf>          -> contents on stdout
    lib/owned-file write <home> <leaf> [mode]   <- contents on stdin

`read` refuses a leaf that is a symlink; `write` publishes through a temporary
file in the same directory and renames it into place, both relative to the
directory FD, so neither call can be redirected by a link planted after the
home was opened. The rename is atomic, so a crash leaves the old file rather
than a truncated one.

The home itself is resolved normally: a home symlinked onto a bigger disk is
ordinary here (load_agent keeps AGENT_HOME normalized for exactly that reason),
and its parents are operator-owned rather than container-owned. What must not
be followed is the leaf, which is the part the gateway can rewrite.

Written for `set-latch`, and general because #25's other half needs the same
primitive: `lib/fetch-tree` publishes into `plugins/` and `skills/` through the
same mount with the same check-then-use bound. One helper for both is the point
-- a second implementation of this containment beside it would be the shape
this repo keeps deleting.
"""

import os
import stat
import sys


def die(message):
    sys.stderr.write("owned-file: %s\n" % message)
    raise SystemExit(1)


def main(argv):
    if len(argv) < 3:
        die("usage: owned-file read|write <home> <leaf> [mode]")
    op, home, leaf = argv[0], argv[1], argv[2]
    if "/" in leaf:
        # A leaf, not a path: every component below the home would need the same
        # treatment, and nothing here has one.
        die("leaf must not contain '/': %s" % leaf)

    try:
        dir_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as exc:
        die("cannot open %s: %s" % (home, exc))

    try:
        if op == "read":
            try:
                # O_NONBLOCK because O_NOFOLLOW rules out a symlink and nothing
                # else: a FIFO planted at the leaf would park this open forever,
                # wedging the command with no diagnostic, and a character device
                # would hand back attacker-chosen bytes to republish into the
                # home. With it the open returns and fstat can say what this is.
                fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
            except OSError as exc:
                # ELOOP is the planted link; anything else is an ordinary
                # missing or unreadable file. Both are named rather than
                # returned as empty, because "no credential" sends the operator
                # to re-mint and revoke a live one.
                die("cannot read %s/%s: %s" % (home, leaf, exc))
            with os.fdopen(fd, "rb") as handle:
                st = os.fstat(handle.fileno())
                if not stat.S_ISREG(st.st_mode):
                    die("refusing to read %s/%s: not a regular file" % (home, leaf))
                sys.stdout.buffer.write(handle.read())
            return

        if op == "write":
            mode = int(argv[3], 8) if len(argv) > 3 else 0o600
            data = sys.stdin.buffer.read()
            # Named from this process rather than randomly, so a crashed run
            # leaves one identifiable file instead of an unbounded litter.
            tmp = ".%s.owned-file.%d" % (leaf, os.getpid())
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode, dir_fd=dir_fd)
            except OSError as exc:
                die("cannot create %s/%s: %s" % (home, tmp, exc))
            try:
                with os.fdopen(fd, "wb") as handle:
                    # On the DESCRIPTOR, never the name. A path-based chmod is a
                    # re-lookup, it follows links, and this temp name is
                    # predictable -- so a gateway looping on it could rename it
                    # away and plant a symlink in time to redirect the mode
                    # change onto an operator-owned path, then have the rename
                    # below publish that link as the leaf. fchmod cannot be
                    # redirected: it names the file this process created.
                    # Needed at all because O_CREAT's mode is masked by umask.
                    os.fchmod(handle.fileno(), mode)
                    handle.write(data)
                    handle.flush()
                    os.fsync(handle.fileno())
                os.rename(tmp, leaf, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
            except OSError as exc:
                try:
                    os.unlink(tmp, dir_fd=dir_fd)
                except OSError:
                    pass
                die("cannot publish %s/%s: %s" % (home, leaf, exc))
            return

        die("unknown operation: %s" % op)
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    main(sys.argv[1:])
