#!/usr/bin/env python3
"""Upsert the Latch pair into an agent's dotenv, contained to its home.

    printf '%s\n%s\n' "$uid" "$tok" | lib/set-latch-env <home>

The home is bind-mounted at /opt/data with the gateway running as the
operator's uid (templates/compose.yml), so `.env` is container-writable. A
host-side tool that opens it by path is doing check-then-use however carefully
it checks first: resolving proves what the path pointed at a moment ago, not
what it points at when the read happens. Issue #25 names the containment-complete
form -- hold the home as a directory FD and work relative to it with no-follow
semantics -- and that is what this does.

Purpose-built rather than a general read/write API. A generic leaf helper was
tried and argued for on the grounds that `lib/fetch-tree` could share it; it
cannot. That seam does `mkdir -p`, `rm -rf`, `cp -a` of a whole tree and two
directory renames, none of which a flat-leaf primitive expresses. With no
second consumer the generality bought nothing and cost surface, so the read,
the upsert and the publish live here behind one directory FD instead of being
a three-process shell protocol around a generic one.

Reads the uid and token as the first two lines of stdin -- never argv, which on
a shared host puts a live relay credential in the process table where `ps`
reads it from any account.

What this buys is containment of the whole operation. The leaf is opened
no-follow under the directory FD and the replacement is renamed into place
under the same FD, so a link planted at `.env` at any point is refused rather
than followed, and the temporary never carries a container-visible name a
gateway could rename away.
"""

import os
import stat
import sys

KEYS = ("DOMO_DEVICE_UID", "DOMO_MCP_TOKEN")


def die(message):
    sys.stderr.write("set-latch-env: %s\n" % message)
    raise SystemExit(1)


def upsert(text, values):
    """Canonical `KEY=value` at column 0 -- the one spelling this tool writes
    and `dotenv_read` is the only reader of. The first declaration of each key
    is rewritten and any later one dropped, so a file that arrived with two
    (appending a line at the bottom is how that happens) leaves with one."""
    out, seen = [], set()
    for line in text.splitlines():
        key = line.split("=", 1)[0] if "=" in line else None
        if key in KEYS:
            if key not in seen:
                seen.add(key)
                out.append("%s=%s" % (key, values[key]))
            continue
        out.append(line)
    for key in KEYS:
        if key not in seen:
            out.append("%s=%s" % (key, values[key]))
    return "\n".join(out) + "\n"


def main(argv):
    if len(argv) != 1:
        die("usage: set-latch-env <home>  (uid and token on stdin)")
    home = argv[0]

    fields = sys.stdin.read().split("\n")
    if len(fields) < 2:
        die("expected DOMO_DEVICE_UID and DOMO_MCP_TOKEN on stdin, one per line")
    # Stripped, so what lands in the file is what the gateway loads -- it strips
    # the value too, and a pasted credential routinely arrives with a trailing
    # space. Empty is then the parser's empty, not the shell's.
    values = {KEYS[0]: fields[0].strip(), KEYS[1]: fields[1].strip()}
    for key in KEYS:
        if not values[key]:
            die("%s was empty -- mint the pair on the Mac running Latch" % key)

    try:
        dir_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as exc:
        die("cannot open %s: %s" % (home, exc))

    try:
        try:
            # O_NONBLOCK because O_NOFOLLOW rules out a symlink and nothing
            # else: a FIFO planted at the leaf would park this open forever,
            # wedging the command with no diagnostic, and a character device
            # would hand back attacker-chosen bytes to republish into the home.
            fd = os.open(".env", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        except OSError as exc:
            die("cannot read %s/.env: %s" % (home, exc))
        with os.fdopen(fd, "rb") as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                die("refusing to read %s/.env: not a regular file" % home)
            current = handle.read().decode("utf-8", "replace")

        updated = upsert(current, values).encode("utf-8")

        # Staged so the gateway has nothing to aim at. A predictable
        # `.env.<pid>` could be renamed away and its name re-created as a
        # symlink in time for the publish to follow it.
        #
        # On Linux O_TMPFILE gives a file with no directory entry at all, so
        # there is no name to race. macOS has no O_TMPFILE and this tool runs
        # there too (README: the floor is 12.3), so the fallback is a temp named
        # from os.urandom -- unguessable rather than absent, which closes the
        # same race by denying the attacker a target. Both publish with a rename
        # under the directory FD, so neither can be redirected out of the home.
        tmp_name = ".env.staged.%s" % os.urandom(8).hex()
        try:
            fd = os.open(home, os.O_WRONLY | os.O_TMPFILE, 0o600)
        except (AttributeError, OSError):
            fd = None

        try:
            if fd is not None:
                with os.fdopen(fd, "wb") as handle:
                    os.fchmod(handle.fileno(), 0o600)
                    handle.write(updated)
                    handle.flush()
                    os.fsync(handle.fileno())
                    # /proc/self/fd is the documented way to name an O_TMPFILE
                    # inode; the link lands under the directory FD.
                    os.link("/proc/self/fd/%d" % handle.fileno(), tmp_name,
                            dst_dir_fd=dir_fd, follow_symlinks=True)
            else:
                fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600,
                             dir_fd=dir_fd)
                with os.fdopen(fd, "wb") as handle:
                    # On the descriptor, never the name: a path-based chmod is a
                    # re-lookup and follows links.
                    os.fchmod(handle.fileno(), 0o600)
                    handle.write(updated)
                    handle.flush()
                    os.fsync(handle.fileno())
            os.rename(tmp_name, ".env", src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp_name, dir_fd=dir_fd)
            except OSError:
                pass
            die("cannot publish %s/.env: %s" % (home, exc))
        return
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    main(sys.argv[1:])
