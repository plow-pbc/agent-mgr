#!/usr/bin/env bash
# Prove the Compose config that will actually be used names the agent we were
# asked for.
#
# load_agent unsets the descriptor keys before reading the file, which prevents
# a stale shell variable from winning. This proves it: it reads back what
# Compose resolved rather than trusting that the prevention held. Cheap, and it
# is the only check that survives someone adding a key to a descriptor and
# forgetting to add it to AGENT_KEYS.
set -euo pipefail
[ -n "${AGENT_MGR_ROOT:-}" ] || { echo "resolve-guard: run me through agent-mgr" >&2; exit 1; }
# shellcheck source=common.sh
. "$AGENT_MGR_ROOT/lib/common.sh"
load_agent "${1:?usage: resolve-guard <name>}"
# Compose agreeing with the descriptor is not the descriptor being RIGHT: a
# copycat naming a sibling's home is self-consistent and satisfies every
# comparison below. Every route through here either starts a gateway or writes,
# so ownership belongs here rather than at each call site -- `up` on a copycat
# would otherwise boot a SECOND gateway against a live home, which is the one
# failure this tool exists to prevent.
require_own_home

resolved="$(compose config --format json)" || die "compose could not resolve a config for $AGENT_NAME"

read -r got_project got_container got_home <<<"$(printf '%s' "$resolved" | python3 -c '
import json, sys
try:
    cfg = json.load(sys.stdin)
except json.JSONDecodeError:
    # Compose printed something that is not a config. Fail as a refusal with the
    # agent named, not as a traceback -- the operator needs to know the guard
    # stopped them, not how it is implemented.
    sys.exit(1)
svc = cfg["services"]["hermes"]
home = ""
for v in svc.get("volumes", []):
    if v.get("target") == "/opt/data":
        home = v.get("source", "")
        break
print(cfg.get("name", "-"), svc.get("container_name", "-"), home or "-")
' 2>/dev/null)" || die "refusing to act: could not read a Compose config for $AGENT_NAME"

[ "$got_project" = "$AGENT_PROJECT" ] \
    || die "refusing to act: compose resolved project '$got_project' but $AGENT_NAME expects '$AGENT_PROJECT'"
[ "$got_container" = "$AGENT_CONTAINER" ] \
    || die "refusing to act: compose resolved container '$got_container' but $AGENT_NAME expects '$AGENT_CONTAINER'"
[ "$got_home" = "$AGENT_HOME" ] \
    || die "refusing to act: compose resolved home '$got_home' but $AGENT_NAME expects '$AGENT_HOME'"
