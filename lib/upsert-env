#!/usr/bin/env python3
"""Upsert named keys into an agent's dotenv, contained to its home.

    printf '%s\n%s\n' "$uid" "$tok" | lib/upsert-env <home> KEY [KEY...]

The home is bind-mounted at /opt/data with the gateway running as the
operator's uid (templates/compose.yml), so `.env` is container-writable. A
host-side tool that opens it by path is doing check-then-use however carefully
it checks first: resolving proves what the path pointed at a moment ago, not
what it points at when the read happens. Issue #25 names the containment-complete
form -- hold the home as a directory FD and work relative to it with no-follow
semantics -- and that is what this does.

Born as `set-latch-env`, purpose-built for the DOMO pair; the keys moved to
argv when `set-home` became the second consumer of the same upsert-under-FD
operation. Key NAMES are not secrets, so argv is fine for them; the flat-leaf
scope is unchanged, and `lib/fetch-tree` still cannot share this (that seam
does whole-tree copies and directory renames a leaf primitive cannot express).

Reads one value per key as the first len(keys) lines of stdin -- never argv,
which on a shared host puts a live credential in the process table where `ps`
reads it from any account.

What this buys is containment of the whole operation. The leaf is opened
no-follow under the directory FD, the replacement is staged outside the mount
entirely, and the rename into place is relative to that same FD -- so a link
planted at `.env` is refused rather than followed, and there is never a
container-visible staging name for a gateway to swap.
"""

import os
import stat
import sys

# The legacy Plow Chat dotenv names and the current names the unified plugin
# reads. --migrate-legacy derives the values from the same no-follow-opened
# bytes it atomically replaces: the values never transit a shell, and there is
# no path-based read for a compromised gateway to symlink-swap between a
# check and the publish.
LEGACY_PAIRS = (
    (b"PLOW_CHAT_TOKEN", b"PLOW_AGENT_TOKEN"),
    (b"PLOW_CHAT_CHAT_UID", b"PLOW_HOME_CHANNEL"),
    (b"PLOW_CHAT_BASE_URL", b"PLOW_API_BASE"),
)


def die(message):
    sys.stderr.write("upsert-env: %s\n" % message)
    raise SystemExit(1)


def upsert(data, keys, values):
    """Canonical `KEY=value` at column 0 -- the one spelling this tool writes
    and `dotenv_read` is the only reader of. The first declaration of each key
    is rewritten and any later one dropped, so a file that arrived with two
    (appending a line at the bottom is how that happens) leaves with one.

    Bytes end to end, and every other line copied verbatim. This file holds
    credentials this tool does not own -- a PMS token, a lock API key -- and
    decoding to str to edit two of its lines would rewrite the rest: a
    non-UTF-8 byte in a password becomes U+FFFD unrecoverably, and str
    splitting treats \x0b, \x0c, \x85, U+2028 and friends as line breaks, so
    one of those inside a value would cut it in half and leave the tail as a
    bogus config line. Split on b"\n" alone rather than bytes.splitlines(),
    which still breaks on \r.
    """
    lines = data.split(b"\n")
    trailing_newline = lines and lines[-1] == b""
    if trailing_newline:
        lines.pop()
    out, seen = [], set()
    for line in lines:
        key = line.split(b"=", 1)[0] if b"=" in line else None
        if key in keys:
            if key not in seen:
                seen.add(key)
                out.append(key + b"=" + values[key])
            continue
        out.append(line)
    for key in keys:
        if key not in seen:
            out.append(key + b"=" + values[key])
    return b"\n".join(out) + b"\n"


def parse(data):
    """Last declaration wins -- the precedence dotenv_read and the compose
    env_file loader give a duplicated key, so the value migrated is the value
    the gateway actually runs with. (upsert's REWRITE keeps the first
    declaration's position; that is about where the line lands, not which
    value a read resolves.)"""
    vals = {}
    for line in data.split(b"\n"):
        if b"=" in line:
            key, val = line.split(b"=", 1)
            vals[key] = val.strip()
    return vals


def migrate_values(current, sync):
    """(keys, values, ledger) for the legacy->current copy, from bytes already
    read under the directory FD. Ledger lines name keys only, never values."""
    keys, values, ledger = [], {}, []
    vals = parse(current)
    for old, new in LEGACY_PAIRS:
        if not sync and vals.get(new):
            ledger.append("%s already set -- left as is" % new.decode("ascii"))
            continue
        val = vals.get(old) or b""
        if not val:
            ledger.append("%s is empty -- nothing to write to %s"
                          % (old.decode("ascii"), new.decode("ascii")))
            continue
        keys.append(new)
        values[new] = val
        ledger.append("wrote %s from %s" % (new.decode("ascii"), old.decode("ascii")))
    return keys, values, ledger


def main(argv):
    if len(argv) < 2:
        die("usage: upsert-env <home> KEY [KEY...]  (one value per key on stdin)")
    home = argv[0]
    migrate = argv[1] == "--migrate-legacy"
    if migrate:
        sync = argv[2:] == ["--sync"]
        if not sync and argv[2:]:
            die("unknown arguments after --migrate-legacy: %s" % " ".join(argv[2:]))
        keys, values = (), {}
    else:
        # Keys arrive as literals from the agent-mgr call sites (set-latch,
        # set-home) -- no validation beyond that; an operator does not reach
        # this helper directly.
        keys = tuple(k.encode("ascii") for k in argv[1:])

        fields = sys.stdin.buffer.read().split(b"\n")
        if len(fields) < len(keys):
            die("expected %d value(s) on stdin, one per line, for: %s"
                % (len(keys), b", ".join(keys).decode("ascii")))
        # Stripped, so what lands in the file is what the gateway loads -- it
        # strips the value too, and a pasted credential routinely arrives with
        # a trailing space. Empty is then the parser's empty, not the shell's.
        values = {key: fields[i].strip() for i, key in enumerate(keys)}
        for key in keys:
            if not values[key]:
                die("%s was empty -- refusing to write an empty value"
                    % key.decode("ascii"))

    try:
        dir_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as exc:
        die("cannot open %s: %s" % (home, exc))

    try:
        try:
            # O_NONBLOCK because O_NOFOLLOW rules out a symlink and nothing
            # else: a FIFO planted at the leaf would park this open forever,
            # wedging the command with no diagnostic, and a character device
            # would hand back attacker-chosen bytes to republish into the home.
            fd = os.open(".env", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        except OSError as exc:
            die("cannot read %s/.env: %s" % (home, exc))
        with os.fdopen(fd, "rb") as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                die("refusing to read %s/.env: not a regular file" % home)
            current = handle.read()

        ledger = []
        if migrate:
            keys, values, ledger = migrate_values(current, sync)
            if not keys:
                for line in ledger:
                    print(line)
                return
        updated = upsert(current, keys, values)

        # Staged OUTSIDE the mount, which is the only place a name is safe.
        # The home's CONTENTS are bind-mounted at /opt/data, so any name inside
        # it -- however unguessable -- is one a compromised gateway can watch
        # for, rename away, and re-create as a symlink before the publish.
        # Randomness stops it planting ahead of time; it does not stop it
        # reacting. The home's parent is not mounted and is on the same
        # filesystem, so a rename from there is still atomic and there is never
        # a container-visible name at all.
        #
        # Resolved first: a home symlinked onto a bigger disk is ordinary here
        # -- the relocation load_agent supports -- so it is the TARGET's parent
        # that has to share the filesystem, not the link's. A home that is a
        # MOUNTPOINT is not a layout anything here creates; it would fail loudly
        # at the rename with `.env` unchanged, which is the right amount of
        # handling for a shape that does not exist.
        #
        # One path, both platforms. This is what retires the O_TMPFILE split --
        # that branch existed to avoid a nameable staging file, which staging
        # off-mount does outright, and it left macOS on a fallback Linux never
        # exercised.
        resolved = os.path.realpath(home)
        tmp_path = os.path.join(
            os.path.dirname(resolved),
            ".%s.upsert-env.%s" % (os.path.basename(resolved), os.urandom(8).hex()))
        try:
            fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except OSError as exc:
            die("cannot stage a replacement beside %s: %s. Nothing was written."
                % (resolved, exc))
        try:
            with os.fdopen(fd, "wb") as handle:
                # On the descriptor, never the name: a path-based chmod is a
                # re-lookup. O_CREAT's mode is masked by umask, so this is what
                # actually pins 0600 on a file about to hold credentials.
                os.fchmod(handle.fileno(), 0o600)
                handle.write(updated)
                handle.flush()
                os.fsync(handle.fileno())
            # Destination relative to the directory FD, so it cannot be
            # redirected out of the home; rename does not follow its
            # destination, so a planted `.env` link is replaced, not written
            # through.
            os.rename(tmp_path, ".env", dst_dir_fd=dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
            die("cannot publish %s/.env: %s. %s/.env is unchanged."
                % (home, exc, home))
        # After the rename, so a failed publish never claims a write.
        for line in ledger:
            print(line)
        return
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    main(sys.argv[1:])
