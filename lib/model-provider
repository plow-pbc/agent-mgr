#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agent_mgr.commands import model_provider
from agent_mgr.errors import AgentMgrError

if len(sys.argv) != 2 or not Path(sys.argv[1]).is_file():
    print(f"no such config: {sys.argv[1] if len(sys.argv) > 1 else '<missing>'}", file=sys.stderr)
    raise SystemExit(1)
try:
    print(model_provider(Path(sys.argv[1])))
except AgentMgrError as error:
    print(error.message, file=sys.stderr)
    raise SystemExit(1) from error
