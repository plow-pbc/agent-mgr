#!/usr/bin/env bash
# Drop backup runs older than N days.
#
#   agent-mgr prune-backups <dest> [days]
#
# A command rather than a `find` in the docs: the predicate is an `rm -rf`, it
# shipped over-broad three times while it lived in Markdown, and the only way to
# test it there was to parse the snippet back out and re-run it.
set -euo pipefail
dest="${1:?usage: agent-mgr prune-backups <dest> [days]}"
days="${2:-14}"

# `days` lands inside find's expression, so it is validated rather than trusted.
# `-1` becomes `-mtime +-1`, which GNU findutils 4.9 happily matches against a
# FRESH directory -- measured -- so one typo'd argument sends the whole backup
# set to `rm -rf`.
# Zero is rejected with the rest: `! -mtime -0` is true of EVERY directory, so
# `prune-backups <dest> 0` deletes the run `backup-homes` wrote seconds earlier
# in the same `&&` and exits 0, which the cron reads as a completed night.
case "$days" in
    ''|*[!0-9]*) echo "prune-backups: days must be a whole number, not '$days'" >&2; exit 1 ;;
esac
[ "$days" -ge 1 ] || { echo "prune-backups: days must be at least 1, not '$days'" >&2; exit 1; }

# Everything under here is ours: `backup-homes` creates this directory and
# writes nothing else into it. That is the whole guard, and it replaces a
# basename grammar that was rewritten three times -- each rewrite correct, each
# one still deleting something of the operator's, because the runs shared a
# directory with their own files. A namespace removes the question instead of
# answering it again.
runs="$dest/backup-homes"
[ -d "$runs" ] || { echo "prune-backups: no runs at $runs -- if $dest is a mount point, it is not mounted" >&2; exit 1; }

# `! -mtime -N` rather than `-mtime +N`: `+N` means STRICTLY more than N full
# days, so it keeps a fifteenth daily run under a documented fourteen --
# measured on a 14-day-old entry, which `+14` spares and this takes.
#
# `-type d` so a stray file in here is left for a human to look at rather than
# deleted. `-maxdepth 1` is a bound rather than load-bearing -- a run holds only
# archives, so nothing below one can match `-type d` anyway -- but this is an
# `rm -rf` and it costs nothing to say how deep it may reach.
#
# `-H` after all. I had reasoned that the starting point is a directory this
# tool creates and so is never a symlink -- but nothing enforces that, and
# `mkdir -p` and `chmod` both succeed quietly when `$dest/backup-homes` already
# IS a symlink onto another disk, which is a natural variant of the symlinked
# destination the HOWTO invites. Under the default `-P` that makes `-mindepth 1`
# match nothing, so retention exits 0 having pruned nothing, forever.
find -H "$runs" -mindepth 1 -maxdepth 1 -type d ! -mtime "-$days" -exec rm -rf {} +
