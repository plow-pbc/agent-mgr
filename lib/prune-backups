#!/usr/bin/env bash
# Drop backup runs older than N days.
#
#   agent-mgr prune-backups <dest> [days]
#
# A command rather than a `find` in the docs, and that is the whole point. The
# predicate is what separates this tool's own output from whatever else the
# operator keeps beside it, every clause of it had to be measured, and it
# shipped over-broad twice while it lived in Markdown -- where the only way to
# test it was to parse the snippet back out and re-run it, which needed its own
# guards against pointing an `rm -rf` at the real home. Behaviour belongs in
# `lib/`; `agent-mgr`'s own header says so.
set -euo pipefail
dest="${1:?usage: agent-mgr prune-backups <dest> [days]}"
days="${2:-14}"

[ -d "$dest" ] || { echo "prune-backups: $dest is not a directory" >&2; exit 1; }

# Only what `backup-homes` writes. `find` narrows by name, mtime and type; the
# shell then checks the grammar, because a glob cannot say "digits" and every
# looser spelling has let an operator's directory through -- measured, each of
# `[0-9]*T[0-9]*Z-[0-9]*`, `backup-homes-????????T??????Z-*` and that plus a
# `.run` tail deleted a `…Z-1-photos` of theirs. Glob `*` is greedy; only a
# character-by-character test ends it.
#
# `-maxdepth 1` so a matching name NESTED in a directory of theirs is out of
# reach; `-type d` so a plain file carrying a run's name is not removed
# recursively; `-H` so a destination symlinked onto a bigger disk resolves at
# all, without which `-mindepth 1` matches nothing and this silently prunes
# nothing forever.
find -H "$dest" -mindepth 1 -maxdepth 1 -type d \
    -name 'backup-homes-*.run' -mtime "+$days" -print0 |
while IFS= read -r -d '' dir; do
    rest="${dir##*/}"; rest="${rest#backup-homes-}"; rest="${rest%.run}"
    case "${rest%-*}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
        *) continue ;;
    esac
    case "${rest##*-}" in ''|*[!0-9]*) continue ;; esac
    rm -rf "$dir"
done
