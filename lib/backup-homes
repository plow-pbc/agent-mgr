#!/usr/bin/env bash
# Snapshot every agent home on this host.
#
# The repo is the image and the home is the volume. `agent-mgr restore` rebuilds
# the image half from git whenever you like. Nothing rebuilds the volume half:
# auth.json, the dotenv, the sessions, the memories and the kanban exist in
# exactly one place.
#
#   agent-mgr backup-homes /somewhere/not/this/disk
#
# A glob rather than the registry: it needs no row to be current, so it catches
# a home mid-migration or not registered yet -- two, measured on this host.
#
# What an archive is and is not worth -- live-copy consistency, retention, a
# home declared outside the glob -- is docs/HOWTO.md § "What an archive is
# worth". Here: only what a maintainer needs before editing the tar call.
set -euo pipefail
dest="${1:?usage: agent-mgr backup-homes <dest>}"

# These archives hold .env and auth.json, so who else can write $dest is the
# whole question -- and it is a PRECONDITION rather than something the run can
# defend against, because write access to a directory is permission to rename
# and unlink its entries and no syscall sequence inside the run beats that.
# Three in-run guards were tried and each was defeated one step later;
# plow-pbc/agent-mgr#34 has them.
#
# One expression: exists, is a directory, is ours, neither write bit. Both bits
# the way ssh treats a private key, since a default umask of 002 makes `mkdir`
# produce 0775. `-H` resolves the starting point, so a destination symlinked
# onto a bigger disk is checked at its target. $dest itself and no further --
# an ancestor someone else can write is outside what this could hold onto.
#
# Two messages, because a missing destination and a loose one want opposite
# remedies, and the missing one carries both of its branches: creating it is
# right on a first run and wrong under an unmounted mount point.
[ -e "$dest" ] \
    || { echo "backup-homes: $dest does not exist. To create it: mkdir -p $dest && chmod 700 $dest -- but if it is a mount point, or a link to one, mount it instead; mkdir would put the archives on the local disk" >&2; exit 1; }
[ -n "$(find -H "$dest" -maxdepth 0 -type d -user "$(id -un)" ! -perm -g+w ! -perm -o+w 2>/dev/null)" ] \
    || { echo "backup-homes: $dest must be a directory you own that nobody else can write -- try: chmod 700 $dest" >&2; exit 1; }

# One directory per run. Not a security boundary -- the check above is that --
# but it is the uniqueness and the unit of pruning. The pid is there because
# the stamp is only second-resolution, and two runs that did collide fail
# loudly here rather than writing over each other.
umask 077
run="$dest/$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir "$run"

# The only tar diagnostics that do not mean the archive is missing something.
# Matched case-insensitively: GNU writes "file changed as we read it" lowercase
# and "File removed before we read it" capitalised, in the same run -- measured
# against the live fleet, where the gateway's kanban.db-wal produces the second.
benign='file changed as we read it|file removed before we read it|file changed size'
err="$(mktemp)"
trap 'rm -f "$err"' EXIT

n=0
for home in "$HOME"/.hermes "$HOME"/.hermes-*; do
    [ -d "$home" ] || continue
    name="$(basename "$home")"
    # `-C "$home" .`, not `-C <parent> <basename>`: a home symlinked onto a
    # bigger disk is supported, and from the parent tar stores that symlink AS a
    # symlink -- exit 0, one entry, no credentials in the archive at all.
    #
    # tar exits 1 for "file changed as we read it", which a running gateway
    # provokes nightly, and refusing that would fail the nightly EVERY night.
    # But the NUMBER cannot carry that decision across the two tars this repo
    # supports. Measured on macOS 14: bsdtar exits 0 for the read race in all
    # three shapes -- an in-place rewrite, a truncate and a grow -- and uses 1
    # for a member it could not open, which it then OMITS. So on a Mac the old
    # `|| [ $? -eq 1 ]` published an archive missing exactly the auth.json this
    # command exists to preserve, exited 0, and let retention prune the good
    # copies behind it. The message can tell them apart; the status cannot.
    #
    # The excludes are most of the bytes and none of the value -- 1.5 GB of
    # homes becomes 439 MB; ${name#.} so a plain `ls` shows the archives.
    #
    # Straight to the final name: the run directory is private already, so there
    # is nothing left for a stage to protect. Staging was tried and introduced
    # more failure modes than it prevented -- plow-pbc/agent-mgr#34 has the
    # rejected shapes.
    status=0
    tar --exclude=./logs --exclude=./cache --exclude=./lazy-packages \
        -C "$home" -czf "$run/${name#.}.tar.gz" . 2>"$err" || status=$?
    cat "$err" >&2
    if [ "$status" != 0 ] && { [ "$status" != 1 ] || grep -Eqvi "$benign" "$err"; }; then
        echo "backup-homes: tar failed on $home (status $status)" >&2
        exit 1
    fi
    n=$((n + 1))
done

# A run that matches nothing must not report success: under the nightly cron the
# cause is likely a crontab installed under a different account, so $HOME is not
# the operator's -- every run then reports success having written nothing.
[ "$n" -gt 0 ] || { echo "backup-homes: no homes matched $HOME/.hermes*" >&2; exit 1; }
