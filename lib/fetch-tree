#!/usr/bin/env python3
"""Install one immutable repository subtree with an atomic rollback-aware swap."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def relative(value: str, label: str) -> Path:
    path = Path(value)
    if path.is_absolute():
        fail(f"the {label} must be relative, got: {value}")
    if any(part in {".", ".."} for part in path.parts):
        fail(f"the {label} may not traverse, got: {value}")
    return path


def manifest_names(file: Path, expected: str) -> bool:
    for line in file.read_text(errors="replace").splitlines():
        key, separator, value = line.partition(":")
        if separator and key == "name" and value.strip() == expected:
            return True
    return False


def main(arguments: list[str]) -> int:
    if not os.environ.get("AGENT_MGR_ROOT"):
        fail("fetch-tree: run me through agent-mgr")
    if len(arguments) not in {6, 7}:
        fail("usage: fetch-tree <home> <root> <manifest> <repo> <ref> <dest> [srcpath]")
    home, root_name, manifest, repository, revision, destination = arguments[:6]
    source_name = arguments[6] if len(arguments) == 7 else ""
    if len(revision) != 40 or any(c not in "0123456789abcdef" for c in revision):
        fail(f"the ref must be a 40-char SHA, got: {revision}")
    destination_path = relative(destination, "destination")
    source_path = relative(source_name, "source path") if source_name else Path()
    tree_name = destination_path.name
    home_path = Path(home).resolve()
    target = home_path / root_name / destination_path
    # Resolve the existing prefix and prove publication remains inside the home.
    target_resolved = target.resolve()
    try:
        target_resolved.relative_to(home_path)
    except ValueError:
        fail(
            f"refusing to install {tree_name}: {target} resolves to {target_resolved}, "
            f"outside {home_path}. A parent directory in the home is a symlink"
        )

    with tempfile.TemporaryDirectory() as temporary:
        temp = Path(temporary)
        archive = subprocess.run(
            ["gh", "api", f"repos/{repository}/tarball/{revision}"],
            capture_output=True,
            check=False,
        )
        if archive.returncode:
            fail(f"could not fetch {repository}@{revision[:7]}")
        archive_path = temp / "src.tgz"
        archive_path.write_bytes(archive.stdout)
        extracted = temp / "tree"
        extracted.mkdir()
        try:
            with tarfile.open(archive_path, "r:gz") as bundle:
                bundle.extractall(extracted, filter="data")
        except (tarfile.TarError, OSError) as error:
            fail(f"{repository}@{revision[:7]} did not unpack as a tarball: {error}")
        roots = list(extracted.iterdir())
        if len(roots) != 1 or not roots[0].is_dir():
            fail(f"{repository}@{revision[:7]} did not unpack as a wrapped tree")
        source = roots[0] / source_path
        if not source.is_dir():
            fail(
                f"{repository}@{revision[:7]} has no {source_name or 'repository root'} to install"
            )
        manifest_path = source / manifest
        if not manifest_path.is_file():
            fail(f"{repository}@{revision[:7]} has no {manifest} -- is that the right path?")
        if not manifest_names(manifest_path, tree_name):
            fail(f"fetched a {manifest} that does not name {tree_name}")

        target.parent.mkdir(parents=True, exist_ok=True)
        incoming = target.with_name(target.name + ".incoming")
        previous = target.with_name(target.name + ".previous")
        if not target.exists() and previous.exists():
            previous.rename(target)
        if incoming.exists():
            shutil.rmtree(incoming)
        if previous.exists():
            shutil.rmtree(previous)
        shutil.copytree(source, incoming, symlinks=True)
        for file in incoming.rglob("*"):
            if file.is_file() and file.suffix in {".py", ".sh"}:
                file.chmod(0o755)
        backed_up = False
        try:
            if target.exists():
                target.rename(previous)
                backed_up = True
            incoming.rename(target)
        except OSError as error:
            if backed_up and previous.exists() and not target.exists():
                previous.rename(target)
            fail(f"could not publish {tree_name}; the previous copy is unchanged: {error}")
        finally:
            if incoming.exists():
                shutil.rmtree(incoming)
        if previous.exists():
            shutil.rmtree(previous)
    count = sum(1 for path in target.rglob("*") if path.is_file())
    print(f"installed {tree_name} at {target} ({count} file(s), from {repository}@{revision[:7]})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
