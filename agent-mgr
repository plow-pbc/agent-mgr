#!/usr/bin/env bash
# agent-mgr -- one CLI for the Hermes agent fleet.
#
# Dispatch only. Every subcommand's behaviour lives in lib/, so the contract
# tests can invoke the real thing rather than grep this file.
set -euo pipefail

AGENT_MGR_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export AGENT_MGR_ROOT
# shellcheck source=lib/common.sh
. "$AGENT_MGR_ROOT/lib/common.sh"

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift

case "$cmd" in
    ls)
        if [ -z "$(registry_list)" ]; then
            echo "no agents registered -- run 'agent-mgr new <name>' or 'agent-mgr register <name> <dir>'"
            exit 0
        fi
        printf '%-16s %s\n' NAME REPO
        registry_list | while IFS=$'\t' read -r name dir; do
            printf '%-16s %s\n' "$name" "$dir"
        done
        ;;
    register)
        [ $# -eq 2 ] || die "usage: agent-mgr register <name> <dir>"
        registry_add "$1" "$2"
        echo "registered $1 -> $(registry_lookup "$1")"
        ;;
    resolve)
        load_agent "${1:-}"
        for k in $AGENT_KEYS AGENT_DESCRIPTOR; do
            printf '%s=%s\n' "$k" "${!k}"
        done
        ;;
    up|down|restart|logs)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        case "$cmd" in
            up)      compose up -d ;;
            down)    compose down ;;
            restart) compose restart hermes ;;
            logs)    compose logs -f --tail 100 ;;
        esac
        ;;
    resolve-guard)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        ;;
    restore)
        load_agent "${1:-}"
        [ -f "$AGENT_DIR/config.yaml" ] || die "$AGENT_DIR has no config.yaml -- an instance repo needs one"
        mkdir -p "$AGENT_HOME"
        umask 077
        [ -f "$AGENT_HOME/.env" ] || install -m 600 "$AGENT_MGR_ROOT/templates/env.example" "$AGENT_HOME/.env"
        # Compared before the copy, because after it they are always identical.
        # restore is the idempotent installer and the first line of the
        # documented bring-up, so bouncing a live gateway on a byte-identical
        # copy drops an in-flight chat turn for nothing.
        if cmp -s "$AGENT_DIR/config.yaml" "$AGENT_HOME/config.yaml"; then changed=; else changed=1; fi
        install -m 600 "$AGENT_DIR/config.yaml" "$AGENT_HOME/config.yaml"
        echo "restored config.yaml to $AGENT_HOME"
        # config.yaml is boot-read, the same as auth.json and .env. Without this
        # the installed file says one thing and the running gateway holds
        # another from its own boot.
        [ -z "$changed" ] || "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the config just installed"
        ;;
    install-plugin)
        load_agent "${1:-}"
        ref="${AGENT_MGR_PLUGIN_REF:-$(tr -d '[:space:]' < "$AGENT_MGR_ROOT/runtime/plow-chat-plugin.ref")}"
        # A SHA, never a branch: a branch would silently re-point a running
        # agent on the next upstream push, and this plugin holds the chat token.
        [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || die "the plugin ref must be a 40-char SHA, got: $ref"
        [ -d "$AGENT_HOME" ] || die "no $AGENT_HOME -- run 'agent-mgr restore $AGENT_NAME' first"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        curl -fsSL "https://raw.githubusercontent.com/plow-pbc/seed-hermes-plow/$ref/ref/scripts/install_direct_mount.sh" -o "$tmp"
        PLOW_CHAT_PLUGIN_REF="$ref" bash "$tmp" --data-dir "$AGENT_HOME"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the plugin just installed"
        ;;
    agent)
        load_agent "${1:-}"; shift
        [ $# -ge 1 ] || die "usage: agent-mgr agent <name> \"<prompt>\""
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        require_running
        # `exec`, not `run`, and this is the whole point of the tool. The image's
        # s6 entrypoint starts a gateway whatever command you pass it, so
        # `docker compose run` brings up a SECOND gateway against this same
        # /opt/data -- which connects to the chat, answers every message
        # alongside the real one, and on exit posts a shutdown notice into the
        # owners' channel.
        #
        # --user is not optional. `exec` skips the entrypoint that remaps the
        # in-image hermes user to HERMES_UID/GID, so a plain exec runs as ROOT
        # and would write root-owned files into a directory the gateway
        # (unprivileged, remapped) then cannot rewrite.
        compose exec -T --user "$HERMES_UID:$HERMES_GID" hermes hermes chat -q "$*"
        ;;
    activate)
        load_agent "${1:-}"
        # activate rewrites PLOW_CHAT_CHAT_UID and PLOW_CHAT_TOKEN in place.
        # Pointed at another agent's home it would take that agent off its chat
        # until /sethome is re-sent, and spend a one-time activation to do it.
        #
        # The conventional home always carries the agent's own name, so it is
        # always allowed. A bare `.hermes` is the legacy shape and is allowed
        # only when the descriptor SAYS SO -- a copied descriptor that inherited
        # a sibling's name fails the first test, and one that fell back to the
        # convention can never produce a bare `.hermes` at all.
        case "$AGENT_HOME" in
            *"/.hermes-$AGENT_NAME") ;;
            */.hermes)
                grep -qE '^[[:space:]]*AGENT_HOME=' "$AGENT_DESCRIPTOR" \
                    || die "activate refuses to target $AGENT_HOME -- ${AGENT_NAME} did not declare that home" ;;
            *) die "activate refuses to target $AGENT_HOME -- that is not ${AGENT_NAME}'s own home" ;;
        esac
        [ -d "$AGENT_HOME" ] || die "no $AGENT_HOME -- run 'agent-mgr restore $AGENT_NAME' first"
        ref="${AGENT_MGR_PLUGIN_REF:-$(tr -d '[:space:]' < "$AGENT_MGR_ROOT/runtime/plow-chat-plugin.ref")}"
        [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || die "the plugin ref must be a 40-char SHA, got: $ref"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        curl -fsSL "https://raw.githubusercontent.com/plow-pbc/seed-hermes-plow/$ref/ref/scripts/create_plow_chat_curl.sh" -o "$tmp"
        bash "$tmp" --data-dir "$AGENT_HOME"
        # Non-fatal, and the message matters more than the restart: by this line
        # the one-time activation is already spent and the token is written. A
        # red exit would read as "activation failed", and the natural response to
        # that is to run it again -- spending a second activation to recover from
        # a docker hiccup.
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the credential just written" \
            || echo "activation SUCCEEDED and the credential is written -- do NOT re-run activate; run 'agent-mgr restart $AGENT_NAME'." >&2
        ;;
    sign-in)
        load_agent "${1:-}"
        installed="$AGENT_HOME/config.yaml"
        [ -f "$installed" ] || die "no $installed -- run 'agent-mgr restore $AGENT_NAME' first"
        require_running
        # Read out of the config the GATEWAY loads, not the instance repo's copy:
        # the gateway resolved model.provider from the installed one at boot, so
        # reading the repo copy would mint a credential for a provider it is not
        # using the moment the two differ.
        provider="$("$AGENT_MGR_ROOT/lib/model-provider" "$installed")"
        compose exec --user "$HERMES_UID:$HERMES_GID" hermes hermes auth add "$provider"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the credential just written"
        ;;
    add-skill)
        load_agent "${1:-}"; shift
        skill_repo="${1:-}"; shift || true
        [ -n "$skill_repo" ] || die "usage: agent-mgr add-skill <name> <owner/repo> [--ref SHA] [--dest PATH] [--src PATH]"
        skill_ref=""; skill_dest=""; skill_src=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --ref)  skill_ref="${2:?--ref needs a SHA}"; shift 2 ;;
                --dest) skill_dest="${2:?--dest needs a path}"; shift 2 ;;
                --src)  skill_src="${2:?--src needs a path}"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        [ -n "$skill_ref" ] || skill_ref="$(gh api "repos/$skill_repo/commits/HEAD" --jq .sha)"
        [[ "$skill_ref" =~ ^[0-9a-f]{40}$ ]] || die "the skill ref must be a 40-char SHA, got: $skill_ref"
        : "${skill_dest:=${skill_repo##*/}}"
        "$AGENT_MGR_ROOT/lib/fetch-skill" "$AGENT_HOME" "$skill_repo" "$skill_ref" "$skill_dest" "$skill_src"
        # Record the pin in the INSTANCE repo: it is that agent's declaration of
        # what it runs, and it belongs under review beside its config.
        tsv="$AGENT_DIR/skills.tsv"; touch "$tsv"
        t="$(mktemp)"
        grep -v "^$skill_repo	" "$tsv" > "$t" || true
        printf '%s\t%s\t%s\t%s\n' "$skill_repo" "$skill_ref" "$skill_dest" "$skill_src" >> "$t"
        sort -o "$t" "$t"; mv "$t" "$tsv"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the skill just installed"
        ;;
    -h|--help|help) usage ;;
    *) printf 'agent-mgr: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
