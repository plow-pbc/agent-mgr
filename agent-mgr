#!/usr/bin/env bash
# agent-mgr -- one CLI for the Hermes agent fleet.
#
# Dispatch only. Every subcommand's behaviour lives in lib/, so the contract
# tests can invoke the real thing rather than grep this file.
set -euo pipefail

AGENT_MGR_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export AGENT_MGR_ROOT
# shellcheck source=lib/common.sh
. "$AGENT_MGR_ROOT/lib/common.sh"

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift

case "$cmd" in
    ls)
        if [ -z "$(registry_list)" ]; then
            echo "no agents registered -- run 'agent-mgr new <name>' or 'agent-mgr register <name> <dir>'"
            exit 0
        fi
        printf '%-16s %s\n' NAME REPO
        registry_list | while IFS=$'\t' read -r name dir; do
            printf '%-16s %s\n' "$name" "$dir"
        done
        ;;
    register)
        [ $# -eq 2 ] || die "usage: agent-mgr register <name> <dir>"
        registry_add "$1" "$2"
        echo "registered $1 -> $(registry_lookup "$1")"
        ;;
    unregister)
        # The way out of the fail-closed arm in require_own_home. `register`
        # cannot serve as one: it refuses a directory that no longer exists,
        # which is exactly the state an unresolvable row is in.
        [ $# -eq 1 ] || die "usage: agent-mgr unregister <name>"
        registry_remove "$1"
        echo "unregistered $1"
        ;;
    resolve)
        load_agent "${1:-}"
        for k in $AGENT_KEYS AGENT_DESCRIPTOR; do
            printf '%s=%s\n' "$k" "${!k-}"
        done
        ;;
    up|down|restart|logs)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        case "$cmd" in
            up)      compose_transition up -d ;;
            down)    compose_transition down ;;
            restart) compose_transition restart hermes ;;
            # Through the same check: logs streams an EXISTING container, so a
            # copycat descriptor would otherwise read production's gateway log.
            logs)    require_running_container_is_ours; compose logs -f --tail 100 ;;   # a read
        esac
        ;;
    resolve-guard)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        ;;
    restore)
        load_agent "${1:-}"
        # Here, at the top, rather than reached through reload-if-running on
        # the last line: it owns the image rule and the ownership check, and a
        # command that installs everything before refusing has already done the
        # thing the refusal exists to prevent.
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        require_transition_allowed
        # Preflight everything this command depends on BEFORE it writes
        # anything. A hook validated only at the end meant a missing one left
        # the plugin and config installed under a message saying the deploy did
        # not land -- a report the state contradicts.
        [ -f "$AGENT_CONFIG" ] || die "no config at $AGENT_CONFIG -- an agent repo needs one, or set AGENT_CONFIG in its agent.env"
        if [ -n "$AGENT_RESTORE_HOOK" ]; then
            [ -x "$AGENT_RESTORE_HOOK" ] || die "$AGENT_NAME declares a restore hook at $AGENT_RESTORE_HOOK, which is missing or not executable -- nothing was installed"
        fi
        mkdir -p "$AGENT_HOME"
        umask 077

        # The instance's own example when it ships one: an agent with extra
        # credentials (a PMS token, a lock API key) knows its dotenv contract
        # better than the fleet template does, and a skeleton missing those keys
        # is a first run that looks complete and is not. Never clobbers.
        skeleton="$AGENT_DIR/.env.example"
        [ -f "$skeleton" ] || skeleton="$AGENT_MGR_ROOT/templates/env.example"
        [ -f "$AGENT_HOME/.env" ] || install -m 600 "$skeleton" "$AGENT_HOME/.env"

        # Plugin before config, deliberately: the installer enables itself by
        # patching a `plugins:` block into whatever config.yaml it finds, so
        # installing the canonical copy afterwards makes it win unconditionally
        # rather than depending on the installer staying idempotent.
        install_plow_plugin "The dotenv skeleton IS written; config.yaml and skills are NOT."

        install -m 600 "$AGENT_CONFIG" "$AGENT_HOME/config.yaml"
        echo "restored config.yaml to $AGENT_HOME"

        # Every pinned skill, replayed. `restore` is advertised as the whole
        # deploy, and a rebuild that omitted them left an agent whose skills.tsv
        # said one thing and whose home held another -- or nothing.
        if [ -s "$AGENT_DIR/skills.tsv" ]; then
            while IFS=$'\t' read -r s_repo s_ref s_dest s_src; do
                [ -n "$s_repo" ] || continue
                "$AGENT_MGR_ROOT/lib/fetch-tree" "$AGENT_HOME" skills SKILL.md "$s_repo" "$s_ref" "$s_dest" "$s_src" \
                    || die "could not replay $s_repo from skills.tsv -- config and plugin ARE installed; re-run restore after fixing the pin"
            done < "$AGENT_DIR/skills.tsv"
        fi

        # The instance's own half, sequenced here so there is one deploy entry
        # point. Its existence was checked in the preflight above; a refusal
        # here is a runtime one, so the message says what already landed.
        if [ -n "$AGENT_RESTORE_HOOK" ]; then
            ( cd "$AGENT_DIR" && env ${AGENT_HOOK_ENV[@]+"${AGENT_HOOK_ENV[@]}"} "$AGENT_RESTORE_HOOK" ) \
                || die "${AGENT_NAME}'s restore hook failed. The config, plugin and pinned skills ARE installed; the hook's own work is NOT. Fix the cause and re-run 'agent-mgr restore $AGENT_NAME' before restarting."
        fi

        # Once, at the end. config.yaml, the plugin and whatever the hook wrote
        # are all boot-read, so reloading between them would bounce a live
        # gateway several times for one deploy.
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "what the restore installed"
        ;;
    install-plugin)
        load_agent "${1:-}"
        # Before the write, as in restore.
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        [ -d "$AGENT_HOME" ] || die "no $AGENT_HOME -- run 'agent-mgr restore $AGENT_NAME' first"
        install_plow_plugin "Nothing else changed -- this agent's config and skills are untouched."
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the plugin just installed"
        ;;
    agent)
        load_agent "${1:-}"; shift
        [ $# -ge 1 ] || die "usage: agent-mgr agent <name> \"<prompt>\""
        require_running
        # `exec`, not `run`, and this is the whole point of the tool. The image's
        # s6 entrypoint starts a gateway whatever command you pass it, so
        # `docker compose run` brings up a SECOND gateway against this same
        # /opt/data -- which connects to the chat, answers every message
        # alongside the real one, and on exit posts a shutdown notice into the
        # owners' channel.
        #
        # --user is not optional. `exec` skips the entrypoint that remaps the
        # in-image hermes user to HERMES_UID/GID, so a plain exec runs as ROOT
        # and would write root-owned files into a directory the gateway
        # (unprivileged, remapped) then cannot rewrite.
        compose exec -T --user "$HERMES_UID:$HERMES_GID" hermes hermes chat -q "$*"
        ;;
    activate)
        load_agent "${1:-}"
        # activate rewrites PLOW_CHAT_CHAT_UID and PLOW_CHAT_TOKEN in place.
        # Pointed at another agent's home it would take that agent off its chat
        # until /sethome is re-sent, and spend a one-time activation to do it.
        #
        # The conventional home always carries the agent's own name, so it is
        # always allowed. A bare `.hermes` is the legacy shape and is allowed
        # only when the descriptor SAYS SO -- a copied descriptor that inherited
        # a sibling's name fails the first test, and one that fell back to the
        # convention can never produce a bare `.hermes` at all.
        require_own_home
        [ -d "$AGENT_HOME" ] || die "no $AGENT_HOME -- run 'agent-mgr restore $AGENT_NAME' first"
        # Its OWN pin, not the plugin's. Same repo, two points in its history:
        # `Strip the SEED ceremony` deleted ref/scripts/, so the plugin pin moves
        # forward past it while create_plow_chat_curl.sh exists only BEFORE it.
        # One shared ref would send the plugin's post-strip SHA at this URL and
        # 404 -- on the one command that is a one-time irreversible spend. So
        # this pin is frozen behind the strip by construction, not by discipline.
        ref="${AGENT_MGR_ACTIVATE_REF:-$(tr -d '[:space:]' < "$AGENT_MGR_ROOT/runtime/plow-chat-activate.ref")}"
        [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || die "the activate ref must be a 40-char SHA, got: $ref"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        curl -fsSL "https://raw.githubusercontent.com/plow-pbc/hermes-plow-chat/$ref/ref/scripts/create_plow_chat_curl.sh" -o "$tmp"
        bash "$tmp" --data-dir "$AGENT_HOME"
        # Non-fatal, and the message matters more than the restart: by this line
        # the one-time activation is already spent and the token is written. A
        # red exit would read as "activation failed", and the natural response to
        # that is to run it again -- spending a second activation to recover from
        # a docker hiccup.
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the credential just written" \
            || echo "activation SUCCEEDED and the credential is written -- do NOT re-run activate; run 'agent-mgr restart $AGENT_NAME'." >&2
        ;;
    sign-in)
        load_agent "${1:-}"
        # It writes a credential into the home like activate does, so it takes
        # the same check. Omitting it let a copied descriptor mint into a
        # sibling's home.
        require_own_home
        installed="$AGENT_HOME/config.yaml"
        [ -f "$installed" ] || die "no $installed -- run 'agent-mgr restore $AGENT_NAME' first"
        require_running
        # Read out of the config the GATEWAY loads, not the agent repo's copy:
        # the gateway resolved model.provider from the installed one at boot, so
        # reading the repo copy would mint a credential for a provider it is not
        # using the moment the two differ.
        provider="$("$AGENT_MGR_ROOT/lib/model-provider" "$installed")"
        compose exec --user "$HERMES_UID:$HERMES_GID" hermes hermes auth add "$provider"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the credential just written"
        ;;
    add-skill)
        load_agent "${1:-}"; shift
        skill_repo="${1:-}"; shift || true
        [ -n "$skill_repo" ] || die "usage: agent-mgr add-skill <name> <owner/repo> [--ref SHA] [--dest PATH] [--src PATH]"
        skill_ref=""; skill_dest=""; skill_src=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --ref)  skill_ref="${2:?--ref needs a SHA}"; shift 2 ;;
                --dest) skill_dest="${2:?--dest needs a path}"; shift 2 ;;
                --src)  skill_src="${2:?--src needs a path}"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        # Before the write, as in restore.
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        [ -n "$skill_ref" ] || skill_ref="$(gh api "repos/$skill_repo/commits/HEAD" --jq .sha)"
        [[ "$skill_ref" =~ ^[0-9a-f]{40}$ ]] || die "the skill ref must be a 40-char SHA, got: $skill_ref"
        : "${skill_dest:=${skill_repo##*/}}"
        "$AGENT_MGR_ROOT/lib/fetch-tree" "$AGENT_HOME" skills SKILL.md "$skill_repo" "$skill_ref" "$skill_dest" "$skill_src"
        # Record the pin in the AGENT repo: it is that agent's declaration of
        # what it runs, and it belongs under review beside its config.
        # Keyed on the DESTINATION, not the repo, and compared as a field.
        # Repo-keyed meant two skills from one monorepo were "the same skill" --
        # adding the second deleted the first's pin, and a clean restore then
        # silently omitted it. And a repo name reaching a regex made `foo.bar`
        # match `fooXbar`. Same ENVIRON-backed shape the registry uses.
        tsv="$AGENT_DIR/skills.tsv"; touch "$tsv"
        t="$(mktemp)"
        dest="$skill_dest" awk -F'\t' '($3 "") != (ENVIRON["dest"] "")' "$tsv" > "$t"
        printf '%s\t%s\t%s\t%s\n' "$skill_repo" "$skill_ref" "$skill_dest" "$skill_src" >> "$t"
        sort -o "$t" "$t"; mv "$t" "$tsv"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the skill just installed"
        ;;
    set-latch)
        load_agent "${1:-}"
        # The same guard activate and sign-in take, for the same reason: this
        # writes a credential into a home, and pointed at a sibling's it would
        # hand that agent a relay credential minted against someone else's Mac.
        require_own_home
        installed="$AGENT_HOME/config.yaml"
        [ -f "$installed" ] || die "no $installed -- run 'agent-mgr restore $AGENT_NAME' first"
        # Refused before anything is written, not after. A pair written for an
        # agent whose config declares no latch is a credential no gateway will
        # ever read, sitting in a dotenv looking like working configuration --
        # which is the state check-latch was written to stop reporting as a
        # revoked token.
        config_declares_latch "$installed" \
            || die "$AGENT_NAME declares no latch server in $installed -- nothing would read this pair"
        env_file="$AGENT_HOME/.env"
        [ -f "$env_file" ] || die "no $env_file -- run 'agent-mgr restore $AGENT_NAME' first"
        # On stdin, never argv, and this is the whole reason the command exists
        # in this shape: check-latch already hands the token to curl as a config
        # on stdin because the argv form puts a live relay credential in the
        # process table of a shared host, readable by `ps` from any account. A
        # --token flag here would undo that one command earlier. Prompts go to
        # stderr so a piped invocation stays clean.
        printf 'DOMO_DEVICE_UID: ' >&2
        IFS= read -r uid || die "no DOMO_DEVICE_UID on stdin"
        printf 'DOMO_MCP_TOKEN: ' >&2
        # -s so the token does not echo into a shared terminal or a scrollback
        # that outlives it. A no-op when stdin is a pipe, which is why the
        # prompt is unconditional rather than gated on a tty test.
        IFS= read -rs tok || die "no DOMO_MCP_TOKEN on stdin"
        printf '\n' >&2
        # Stripped here as well as in the helper, which is authoritative -- what
        # goes down the pipe is then what lands in the file, so the confirmation
        # below reports the same last three characters check-latch will. Reading
        # the raw value instead announced `...z  ` for a padded paste while
        # check-latch's REVOKED line said `...xyz`, and two spellings of one
        # credential is what sends an operator to revoke a live token.
        uid="${uid#"${uid%%[![:space:]]*}"}"; uid="${uid%"${uid##*[![:space:]]}"}"
        tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"
        # One process does the read, the upsert and the publish, all under a
        # single directory FD on the home -- lib/upsert-env. It also owns the
        # value strip and the emptiness check, so there is one definition of
        # what an empty credential is rather than a shell copy drifting from it.
        #
        # The three-process shell protocol this replaces could not hold that
        # boundary: each stage re-opened `.env` by name, and the pipeline had to
        # be split into captured stages so a dying transform could not publish
        # truncated content over the file. One process needs neither.
        printf '%s\n%s\n' "$uid" "$tok" \
            | "$AGENT_MGR_ROOT/lib/upsert-env" "$AGENT_HOME" DOMO_DEVICE_UID DOMO_MCP_TOKEN \
            || die "refusing to write ${AGENT_NAME}'s dotenv -- see above. Nothing was written."
        echo "wrote DOMO_DEVICE_UID and DOMO_MCP_TOKEN (...${tok: -3}) to $env_file"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the credential just written"
        echo "now prove it reaches the Mac: agent-mgr check-latch $AGENT_NAME"
        ;;
    check-latch)
        load_agent "${1:-}"
        env_file="$AGENT_HOME/.env"
        [ -f "$env_file" ] || die "no $env_file -- run 'agent-mgr restore $AGENT_NAME' first"
        # The CONFIG is the declaration, not the dotenv. Keying off the
        # credential looked equivalent and is not: a leftover DOMO_* pair from an
        # earlier experiment sits in a dotenv long after the config stopped
        # declaring a latch server, and this then probed a relay for an agent
        # that cannot reach it -- reporting a revoked token as a failure of an
        # agent that never used one. Read from the INSTALLED config, which is
        # what the gateway loaded, for the same reason sign-in does.
        installed="$AGENT_HOME/config.yaml"
        [ -f "$installed" ] || die "no $installed -- run 'agent-mgr restore $AGENT_NAME' first"
        if ! config_declares_latch "$installed"; then
            echo "no latch configured for $AGENT_NAME -- its config declares no latch server"
            exit 0
        fi
        uid="$(dotenv_read DOMO_DEVICE_UID "$env_file")"
        tok="$(dotenv_read DOMO_MCP_TOKEN "$env_file")"
        [ -n "$uid" ] || die "DOMO_DEVICE_UID is empty in $env_file -- mint the pair on the Mac, then: agent-mgr set-latch $AGENT_NAME"
        [ -n "$tok" ] || die "DOMO_MCP_TOKEN is empty in $env_file -- mint the pair on the Mac, then: agent-mgr set-latch $AGENT_NAME"
        require_running
        err="$(mktemp)"; trap 'rm -f "$err"' EXIT
        # Asked from INSIDE the container, because the container is what has to
        # reach api.plow.co. Egress, DNS and CA config all differ between this
        # shell and that network namespace, and every one of those failures is
        # invisible to a host-side probe. There is deliberately no host
        # fallback: a host answer is exactly the evidence entering the namespace
        # was meant to stop accepting.
        #
        # The token goes in on STDIN as a curl config, never in argv. Spelled
        # out because the argv form looked equivalent: `docker compose exec ...
        # -H "Authorization: Bearer $tok"` puts the live relay credential in the
        # process table of a shared host for the length of the probe, readable
        # by `ps` from any account. printf is a shell builtin, so the host side
        # forks nothing carrying it either.
        code="$(printf 'header = "Authorization: Bearer %s"\n' "$tok" \
            | compose exec -T hermes \
            curl -sS --max-time 30 -o /dev/null -w '%{http_code}' --config - \
            -X POST "https://api.plow.co/v1/relay/devices/$uid/mcp" \
            -H 'Content-Type: application/json' \
            -H 'Accept: application/json, text/event-stream' \
            -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}' 2>"$err")" || true
        # A dead credential and a dead network need different fixes, so they must
        # not collapse into one message.
        case "$code" in
            200) echo "latch reachable from ${AGENT_NAME}'s container (HTTP 200)" ;;
            401) die "DOMO_MCP_TOKEN (...${tok: -3}) is REVOKED -- mint a fresh pair on the Mac, then: agent-mgr set-latch $AGENT_NAME" ;;
            000) die "no answer from api.plow.co -- the credential was NOT tested: $(tr '\n' ' ' < "$err")" ;;
            *)   die "relay returned HTTP ${code:-<none>}: $(tr '\n' ' ' < "$err")" ;;
        esac
        ;;
    chats)
        load_agent "${1:-}"
        require_running
        # The account's chats with the line each is on, the current home chat
        # marked. This is the listing set-home works from: after a re-activation
        # has moved an agent to a fresh line, the old line's DM is the uid that
        # brings its group chats back.
        home_uid="$(dotenv_read PLOW_CHAT_CHAT_UID "$AGENT_HOME/.env")"
        # Captured, not piped: a die inside the left side of a pipeline only
        # exits its subshell, and the Python below would then crash on empty
        # stdin with a traceback burying the real error.
        chats_json="$(plow_chats_json)"
        printf '%s' "$chats_json" | HOME_UID="$home_uid" python3 -I -c '
import json, os, sys
home = os.environ.get("HOME_UID", "")
rows = []
for chat in json.load(sys.stdin)["data"]:
    line = next((p["line"] for p in chat.get("participants", []) if p.get("type") == "agent"), {})
    members = [p.get("display_name") or p.get("provider_key", "?")
               for p in chat.get("participants", []) if p.get("type") == "member"]
    rows.append(("*" if chat["uid"] == home else " ", chat["uid"], line.get("uid", "?"),
                 line.get("provider_key", "?"), chat.get("display_name") or ", ".join(members)))
for row in rows:
    print("%s %-28s %-6s %-13s %s" % row)
if home and home not in {r[1] for r in rows}:
    print("home chat %s is not in this listing -- the token and the home may disagree" % home, file=sys.stderr)
'
        ;;
    set-home)
        load_agent "${1:-}"
        # Writes into a home like activate does, so it takes the same guard.
        require_own_home
        chat_uid="${2:-}"
        [[ "$chat_uid" =~ ^cht_[A-Za-z0-9_-]+$ ]] || die "usage: agent-mgr set-home <name> <cht_...>  (find the uid with 'agent-mgr chats $AGENT_NAME')"
        require_running
        # Refused unless this token can see the chat. The Plow token is
        # user-scoped -- the agent's LINE identity comes from whichever line its
        # home chat is on -- so re-pointing the home at another line's DM is the
        # supported recovery after `activate` has moved the agent to a fresh
        # line and stranded the old line's group chats. A uid outside the
        # listing is a typo or a sibling account's chat; writing it would take
        # the agent off its chat entirely, so it dies here instead.
        # Captured for the same reason as in `chats`: a fetch failure must die
        # with its own message, not fall through to the not-among-chats one.
        chats_json="$(plow_chats_json)"
        printf '%s' "$chats_json" | CHAT_UID="$chat_uid" python3 -I -c '
import json, os, sys
uids = {c["uid"] for c in json.load(sys.stdin)["data"]}
sys.exit(0 if os.environ["CHAT_UID"] in uids else 1)
' || die "$chat_uid is not among this token's chats -- run 'agent-mgr chats $AGENT_NAME' and pick a uid from that listing"
        printf '%s\n' "$chat_uid" \
            | "$AGENT_MGR_ROOT/lib/upsert-env" "$AGENT_HOME" PLOW_CHAT_CHAT_UID \
            || die "refusing to write ${AGENT_NAME}'s dotenv -- see above. Nothing was written."
        echo "wrote PLOW_CHAT_CHAT_UID=$chat_uid to $AGENT_HOME/.env"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the home chat just re-pointed"
        ;;
    check-connectors)
        load_agent "${1:-}"
        require_running
        # Checked once, by name. Without this every connector reports the same
        # generic "probe did not run -- no such file or directory", which is the
        # least informative way to say "the skill is not installed".
        compose exec -T --user "$HERMES_UID:$HERMES_GID" hermes \
            test -f /opt/data/skills/plow-connectors/plow_connector.py 2>/dev/null \
            || die "the plow-connectors skill is not installed in $AGENT_NAME -- run: agent-mgr add-skill $AGENT_NAME plow-pbc/hermes-plow-chat --dest plow-connectors --src ref/hermes-skill/plow-connectors"
        rc=0
        for c in gmail slack; do
            # `connected:false` is a real answer, not a failure -- it means the
            # connector is not linked to that Plow account yet.
            if out="$(compose exec -T --user "$HERMES_UID:$HERMES_GID" hermes \
                    python3 /opt/data/skills/plow-connectors/plow_connector.py "$c" status 2>&1)"; then
                printf '%s: %s\n' "$c" "$out"
            else
                printf '%s: probe did not run -- %s\n' "$c" "$(printf '%s' "$out" | tr '\n' ' ')" >&2
                rc=1
            fi
        done
        exit "$rc"
        ;;
    new)
        name="${1:-}"; [ -n "$name" ] || die "usage: agent-mgr new <name> [dir]"
        registry_valid_name "$name"
        dir="${2:-$PWD/$name-hermes-agent}"
        # On the NAME first. Scaffolding an already-registered name at a fresh
        # directory passes any directory-scoped check and then silently repoints
        # the registry -- and because the template descriptor is all comments,
        # the new row resolves to the SAME home, so the next documented step
        # (`restore`) installs the template config over a live agent's own and
        # reloads its gateway.
        if existing="$(registry_lookup "$name" 2>/dev/null)"; then
            die "$name is already registered at $existing -- pick another name, or use 'agent-mgr register' to repoint it"
        fi
        # Either file, not just one: this command writes both, and a directory
        # holding a hand-written config.yaml would otherwise pass the refusal and
        # have it replaced by the template.
        for f in agent.env config.yaml; do
            [ -e "$dir/$f" ] && die "$dir already has $f -- refusing to overwrite it"
        done
        mkdir -p "$dir"
        install -m 644 "$AGENT_MGR_ROOT/templates/agent.env" "$dir/agent.env"
        install -m 644 "$AGENT_MGR_ROOT/templates/config.yaml" "$dir/config.yaml"
        registry_add "$name" "$dir"
        # The home is NOT created here. install-plugin and activate both gate on
        # it existing as their "run restore first" ordering check, and
        # pre-creating it lets activate spend a one-time activation into a home
        # restore has never prepared. restore creates it, which is its job.
        # Reported from the resolver rather than restated, so the convention has
        # one owner.
        load_agent "$name"
        cat <<EOF
scaffolded $name at $dir
  home:     $AGENT_HOME (created by restore)

bring it up:
  agent-mgr restore $name          # the whole deploy: config, plugin, and this
                                   # agent's own restore hook if it declares one
  agent-mgr activate $name         # prints a code; text it from the agent's phone
  agent-mgr up $name
  agent-mgr sign-in $name          # model OAuth, in a browser

then, if it drives a Mac through Latch, mint the pair on that Mac and:
  agent-mgr set-latch $name        # prompts for the pair; nothing on argv
  agent-mgr check-latch $name
EOF
        ;;
    compose)
        # Escape hatch for an agent's own DOMAIN recipes -- a one-off maintenance
        # container, an on-demand end-to-end run -- so they do not have to
        # restate agent-mgr's file list, override convention and env-file to
        # reach the same service. Deployment stays defined in one place.
        #
        # HERMES_UID/GID are exported by load_agent, so a passthrough inherits
        # the same ownership contract as every other subcommand.
        #
        # `run` through here MUST pass --entrypoint. Without it the image's s6
        # entrypoint boots a gateway alongside the live one, which is the whole
        # failure this tool exists to prevent; with it, s6 never starts.
        load_agent "${1:-}"; shift
        [ $# -ge 1 ] || die "usage: agent-mgr compose <name> <docker compose args...>"
        # The subcommand is $1, not a word found somewhere in the argv. agent-mgr
        # supplies the global options itself, so a caller has none to pass --
        # and that is enforced rather than assumed, because every check below
        # keys on $1 and a leading global would shift the subcommand out from
        # under all of them at once.
        case "$1" in
            -*) die "refusing 'compose $1': the subcommand must come first. agent-mgr supplies the global options (-p, --env-file, -f) itself, and every guard here reads the subcommand as the first word." ;;
        esac
        # Ahead of resolve-guard and classification, like the `run` rule below:
        # a refused subcommand must be told it is refused, not sent through an
        # identification whose remedies are doors that do not open for it.
        require_fetch_is_safe "$@"
        if [ "$1" = "run" ]; then
            # Status captured, not tested bare: under `set -e` a non-zero
            # return from a simple command kills the script before the case.
            entry_rc=0; run_replaces_the_entrypoint "$@" || entry_rc=$?
            case $entry_rc in
                0) ;;
                # Told apart, because "not first" is wrong advice for a caller
                # who put it first and left the value off.
                2) die "refusing 'compose run': --entrypoint is first but has no value, so it overrides nothing and the image's s6 still boots a gateway beside the live one" ;;
                *) die "refusing 'compose run' whose first argument is not --entrypoint: without a replaced entrypoint the image's s6 starts a second gateway against ${AGENT_NAME}'s home. Put it first -- 'run --entrypoint bash --rm ... hermes'." ;;
            esac
        fi
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        # Leaves-it-running passes through; everything else is a transition and
        # asks the veto, whether or not this tool has heard of it.
        if compose_transitions_nothing "$1"; then
            # Everything not exempt is gated -- see COMPOSE_NEEDS_NO_IDENTIFICATION
            # in lib/common.sh for which and why. Locally: `compose rowan cp
            # ./x hermes:/opt/data/` writes into whatever runs under that project.
            case " $COMPOSE_NEEDS_NO_IDENTIFICATION " in
                *" $1 "*) ;;
                *) require_running_container_is_ours ;;
            esac
            compose "$@"
        else
            compose_transition "$@"
        fi
        ;;
    -h|--help|help) usage ;;
    *) printf 'agent-mgr: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
