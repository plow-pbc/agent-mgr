#!/usr/bin/env bash
# agent-mgr -- one CLI for the Hermes agent fleet.
#
# Dispatch only. Every subcommand's behaviour lives in lib/, so the contract
# tests can invoke the real thing rather than grep this file.
set -euo pipefail

AGENT_MGR_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export AGENT_MGR_ROOT
# shellcheck source=lib/common.sh
. "$AGENT_MGR_ROOT/lib/common.sh"

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 2; }
shift

case "$cmd" in
    ls)
        if [ -z "$(registry_list)" ]; then
            echo "no agents registered -- run 'agent-mgr new <name>' or 'agent-mgr register <name> <dir>'"
            exit 0
        fi
        printf '%-16s %s\n' NAME REPO
        registry_list | while IFS=$'\t' read -r name dir; do
            printf '%-16s %s\n' "$name" "$dir"
        done
        ;;
    register)
        [ $# -eq 2 ] || die "usage: agent-mgr register <name> <dir>"
        registry_add "$1" "$2"
        echo "registered $1 -> $(registry_lookup "$1")"
        ;;
    resolve)
        load_agent "${1:-}"
        for k in $AGENT_KEYS AGENT_DESCRIPTOR; do
            printf '%s=%s\n' "$k" "${!k}"
        done
        ;;
    up|down|restart|logs)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        case "$cmd" in
            up)      compose up -d ;;
            down)    compose down ;;
            restart) compose restart hermes ;;
            logs)    compose logs -f --tail 100 ;;
        esac
        ;;
    resolve-guard)
        load_agent "${1:-}"
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        ;;
    restore)
        load_agent "${1:-}"
        [ -f "$AGENT_DIR/config.yaml" ] || die "$AGENT_DIR has no config.yaml -- an instance repo needs one"
        mkdir -p "$AGENT_HOME"
        umask 077
        [ -f "$AGENT_HOME/.env" ] || install -m 600 "$AGENT_MGR_ROOT/templates/env.example" "$AGENT_HOME/.env"
        # Compared before the copy, because after it they are always identical.
        # restore is the idempotent installer and the first line of the
        # documented bring-up, so bouncing a live gateway on a byte-identical
        # copy drops an in-flight chat turn for nothing.
        if cmp -s "$AGENT_DIR/config.yaml" "$AGENT_HOME/config.yaml"; then changed=; else changed=1; fi
        install -m 600 "$AGENT_DIR/config.yaml" "$AGENT_HOME/config.yaml"
        echo "restored config.yaml to $AGENT_HOME"
        # config.yaml is boot-read, the same as auth.json and .env. Without this
        # the installed file says one thing and the running gateway holds
        # another from its own boot.
        [ -z "$changed" ] || "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the config just installed"
        ;;
    install-plugin)
        load_agent "${1:-}"
        ref="${AGENT_MGR_PLUGIN_REF:-$(tr -d '[:space:]' < "$AGENT_MGR_ROOT/runtime/plow-chat-plugin.ref")}"
        # A SHA, never a branch: a branch would silently re-point a running
        # agent on the next upstream push, and this plugin holds the chat token.
        [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || die "the plugin ref must be a 40-char SHA, got: $ref"
        [ -d "$AGENT_HOME" ] || die "no $AGENT_HOME -- run 'agent-mgr restore $AGENT_NAME' first"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        curl -fsSL "https://raw.githubusercontent.com/plow-pbc/seed-hermes-plow/$ref/ref/scripts/install_direct_mount.sh" -o "$tmp"
        PLOW_CHAT_PLUGIN_REF="$ref" bash "$tmp" --data-dir "$AGENT_HOME"
        "$AGENT_MGR_ROOT/lib/reload-if-running" "$AGENT_NAME" "the plugin just installed"
        ;;
    agent)
        load_agent "${1:-}"; shift
        [ $# -ge 1 ] || die "usage: agent-mgr agent <name> \"<prompt>\""
        "$AGENT_MGR_ROOT/lib/resolve-guard" "$AGENT_NAME"
        require_running
        # `exec`, not `run`, and this is the whole point of the tool. The image's
        # s6 entrypoint starts a gateway whatever command you pass it, so
        # `docker compose run` brings up a SECOND gateway against this same
        # /opt/data -- which connects to the chat, answers every message
        # alongside the real one, and on exit posts a shutdown notice into the
        # owners' channel.
        #
        # --user is not optional. `exec` skips the entrypoint that remaps the
        # in-image hermes user to HERMES_UID/GID, so a plain exec runs as ROOT
        # and would write root-owned files into a directory the gateway
        # (unprivileged, remapped) then cannot rewrite.
        compose exec -T --user "$HERMES_UID:$HERMES_GID" hermes hermes chat -q "$*"
        ;;
    -h|--help|help) usage ;;
    *) printf 'agent-mgr: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
